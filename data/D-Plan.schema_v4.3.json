{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esun-ai-challenge.tw/schemas/D-Plan.schema.json",
  "title": "D-Plan — 當日 Agent 決策報告及交易書",
  "description": "每台股交易日繳交之 JSON 文件（每日唯一繳交物），包含決策過程和當日委托內容。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_type",
    "team_id",
    "trade_date",
    "sources",
    "observations",
    "market_view",
    "inferences",
    "decisions",
    "no_trade_decisions",
    "orders",
    "agent_metadata"
  ],
  "properties": {
    "_NOTE": {
      "type": "string",
      "description": "非正式欄位：範例檔備註用，正式提交可省略"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^4\\.\\d+$",
      "description": "規格版本，填 4.x（例如 4.3）"
    },
    "doc_type": {
      "const": "D-Plan"
    },
    "team_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "隊伍ID，作為識別上傳檔案的隊伍欄位"
    },
    "trade_date": {
      "$ref": "#/$defs/date",
      "description": "「本計劃書所對應之交易日（非繳交日）」"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/source"
      },
      "description": "L0 資料來源層。列出本份計劃書實際引用的所有資料來源。"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/observation"
      },
      "description": "L1 資訊擷取層：只准可核對的事實，禁止推論性語句"
    },
    "market_view": {
      "$ref": "#/$defs/market_view",
      "description": "L2M 整體市場判斷鏈（必填）：市場級依據 → 走向研判 → 風險姿態 → 可驗證的部位含意。系統會檢查宣告與委託總效果的一致性"
    },
    "inferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/inference"
      },
      "description": "L2 個股推論層：事實 + 策略規則 → 結論"
    },
    "decisions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/decision"
      },
      "description": "L3 決策層（異動）。無交易日可為空陣列，但 no_trade_decisions 仍須完整"
    },
    "no_trade_decisions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/no_trade_decision"
      },
      "description": "L3 決策層（續抱）：每檔未異動持股各一筆，附理由引用。未通過即整份退回"
    },
    "orders": {
      "type": "array",
      "minItems": 0,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/order"
      },
      "description": "L4 委託層。須與《D-Plan 撰寫指南》§⑥ 的推導演算法（輸入為 decisions、資料包的前日結算持股與淨值、交易所前日收盤價）結果一致（比對 ticker / side / shares）"
    },
    "agent_metadata": {
      "$ref": "#/$defs/agent_metadata"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+08:00$",
      "description": "ISO-8601，一律台北時區 +08:00"
    },
    "sha256_prefixed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ticker": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "authority",
        "url",
        "content_as_of"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[0-9]{1,3}$",
          "description": "層內唯一"
        },
        "authority": {
          "enum": [
            "twse",
            "tpex",
            "taifex",
            "mops",
            "fininst",
            "media",
            "vendor",
            "other"
          ],
          "description": "twse/tpex/taifex/mops=交易所與主管機關公開資料（事後重抓比值）；fininst=投信/券商/銀行等金融機構發布之研究報告、基金與 ETF 資料；media=新聞媒體；vendor=行情/數據服務商（CMoney、富果 Fugle 等之 API 或數據）；清單未涵蓋者填 other"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "name": {
          "type": "string",
          "maxLength": 300,
          "description": "選填，人讀名稱"
        },
        "archive_url": {
          "type": "string",
          "format": "uri",
          "description": "選填。第三方存檔（web.archive.org / archive.today）。此欄是 media/vendor 內容真實性的外部佐證，建議填入；有存檔者抽檢直接採信，無存檔之關鍵來源列合理性審查優先"
        },
        "published_at": {
          "$ref": "#/$defs/timestamp",
          "description": "選填。新聞/公告之發布時間"
        },
        "content_as_of": {
          "$ref": "#/$defs/timestamp",
          "description": "資料內容所描述之時點（非抓取時間）。"
        },
        "fetched_at": {
          "$ref": "#/$defs/timestamp",
          "description": "選填。抓取時刻僅供異常排查；有填時須 ≤ server 收件戳"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obs_id",
        "source_ref",
        "statement",
        "values"
      ],
      "properties": {
        "obs_id": {
          "type": "string",
          "pattern": "^O[0-9]{1,3}$"
        },
        "source_ref": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^S[0-9]{1,3}$"
          },
          "description": "每個 id 必須存在於 sources。未通過即整份退回"
        },
        "topic": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,40}$",
          "description": "選填分類標籤"
        },
        "statement": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number"
          },
          "description": "抽檢時逐值回對證據包快照；只收數字"
        }
      }
    },
    "market_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_refs",
        "logic",
        "regime",
        "stance",
        "posture",
        "counter_evidence"
      ],
      "properties": {
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^O[0-9]{1,3}$"
          },
          "description": "市場級依據（大盤、期貨夜盤、隔夜美股、匯率、巨集事件之 obs_id）；每個 id 必須存在於 observations。未通過即整份退回"
        },
        "logic": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "description": "從依據推到走向與姿態的過程（抽檢時對照公開說明書之投資理念審一致性）"
        },
        "regime": {
          "enum": [
            "risk_on",
            "neutral",
            "risk_off"
          ],
          "description": "整體市場走向研判"
        },
        "stance": {
          "enum": [
            "aggressive",
            "neutral",
            "defensive"
          ],
          "description": "本日操作姿態（積極/中性/保守）"
        },
        "posture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "net_exposure_intent",
            "target_cash_pct_range"
          ],
          "properties": {
            "net_exposure_intent": {
              "enum": [
                "increase",
                "hold",
                "reduce"
              ],
              "description": "淨曝險意圖。收件時以 T-1 交易所收盤價重算委託淨流向比對：increase→淨買超；reduce→淨賣超；hold→|淨流向| ≤ 容差（server 參數，預設 2% NAV）。"
            },
            "target_cash_pct_range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.25
              },
              "description": "目標現金區間 [下限, 上限]，須下限 ≤ 上限。收件時以 T-1 收盤價重算委託後預估現金比，比對是否落在區間內。註：實際成交為 T 日均價，市值以 T 日收盤價計算"
            }
          }
        },
        "counter_evidence": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "與研判相反的市場訊號；無則明填 null"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "選填"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inf_id",
        "premise_refs",
        "logic",
        "counter_evidence"
      ],
      "properties": {
        "inf_id": {
          "type": "string",
          "pattern": "^I[0-9]{1,3}$"
        },
        "premise_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^O[0-9]{1,3}$"
          },
          "description": "每個 id 必須存在於 observations。未通過即整份退回"
        },
        "logic": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "description": "推導過程：哪些前提、為何成立"
        },
        "conclusion": {
          "type": "string",
          "maxLength": 300,
          "description": "選填，人讀摘要"
        },
        "counter_evidence": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "與本推論相反的訊號；無則明填 null"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "選填"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "ticker",
        "action",
        "target_weight",
        "inference_refs"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^D[0-9]{1,3}$"
        },
        "ticker": {
          "$ref": "#/$defs/ticker"
        },
        "action": {
          "enum": [
            "BUY",
            "ADD",
            "TRIM",
            "SELL_ALL"
          ],
          "description": "決策動作：BUY 新建倉（前一交易日結算持股為 0）／ADD 加碼既有持股／TRIM 減碼但保留部位／SELL_ALL 全數出清"
        },
        "target_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25,
          "description": "本日委託執行後之目標權重，由參賽者自訂；orders 推導（見《D-Plan 撰寫指南》§⑥）。單位為比率（0.19 = 19%），分母為前日結算淨值（資料包 account.nav_tradable）。"
        },
        "inference_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^I[0-9]{1,3}$"
          },
          "description": "每個 id 必須存在於 inferences；每筆決策至少引用 1 筆推論（不得為孤兒決策）。未通過即整份退回"
        },
        "risk_check": {
          "type": "string",
          "maxLength": 300,
          "description": "選填，人讀自述"
        },
        "funding_for": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{1,3}$"
          },
          "description": "選填。資金調度宣告：本筆賣出（限 action=TRIM/SELL_ALL）是為了支應所列之同日 BUY/ADD 決策。系統檢核：①引用存在且指向買進決策；②缺口存在性——不執行全部調度賣出時，重算現金比須低於 market_view.target_cash_pct_range 下限，否則「錢夠卻宣稱調度」與數字矛盾。動機可複合（訊號＋調度並存合法）；標記後推論應說明「為何選此標的讓位」之選擇邏輯"
        }
      }
    },
    "no_trade_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "reason_refs"
      ],
      "properties": {
        "ticker": {
          "$ref": "#/$defs/ticker"
        },
        "reason_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "pattern": "^I[0-9]{1,3}$"
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 300,
          "description": "選填，人讀理由"
        }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "side",
        "shares",
        "decision_ref"
      ],
      "properties": {
        "ticker": {
          "$ref": "#/$defs/ticker"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "shares": {
          "type": "integer",
          "minimum": 1000,
          "multipleOf": 1000,
          "description": "整股限制：千股之正整數倍。未通過即整份退回"
        },
        "decision_ref": {
          "type": "string",
          "pattern": "^D[0-9]{1,3}$",
          "description": "須存在於 decisions，未通過即整份退回；本筆委託須與該決策的推導結果一致"
        },
        "derivation_detail": {
          "type": "string",
          "maxLength": 300,
          "description": "選填，人讀推導展開式"
        }
      }
    },
    "agent_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_provider",
        "model_version",
        "run_started_at",
        "run_completed_at",
        "code_version"
      ],
      "properties": {
        "model_provider": {
          "enum": [
            "anthropic",
            "openai",
            "google",
            "xai",
            "deepseek",
            "alibaba",
            "meta",
            "mistral",
            "cohere",
            "amazon",
            "microsoft",
            "nvidia",
            "taide",
            "other"
          ],
          "description": "模型供應商。自架開放權重模型請填**釋出權重的組織**（如 Llama → meta、Qwen → alibaba）；清單未涵蓋者填 other，並於 model_version 寫明。"
        },
        "model_version": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60,
          "description": "抽檢重跑須用同一版本"
        },
        "run_started_at": {
          "$ref": "#/$defs/timestamp",
          "description": "自報之執行起始時間，供排查參考"
        },
        "run_completed_at": {
          "$ref": "#/$defs/timestamp",
          "description": "自報之執行完成時間，須 ≤ server 收件戳"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "選填，自報用量紀錄"
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "選填，自報用量紀錄"
        },
        "tool_use_count": {
          "type": "integer",
          "minimum": 0,
          "description": "選填，自報用量紀錄"
        },
        "code_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:/\\-]{1,64}$",
          "description": "當日程式碼版本識別，格式不限——git commit（git:a1b2c3d）、版本號（v1.4.2）、或當日程式碼打包檔之 sha256 前綴皆可。"
        }
      }
    }
  }
}
